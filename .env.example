# Obligatoire
DJANGO_SECRET_KEY=generate-a-new-random-secret

# Développement local
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=indicateurs.example.fr
# DJANGO_CSRF_TRUSTED_ORIGINS=https://indicateurs.example.fr
# DJANGO_SECURE_PROXY_SSL_HEADER=true

# PostgreSQL en production
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=indicateurs
# DJANGO_DB_USER=indicateurs
# DJANGO_DB_PASSWORD=change-me
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# SMTP en production
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.fr
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_HOST_USER=noreply@example.fr
# DJANGO_EMAIL_HOST_PASSWORD=change-me
# DJANGO_DEFAULT_FROM_EMAIL=Plateforme indicateurs <noreply@example.fr>
